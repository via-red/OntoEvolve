# ============================================
# OntoEvolve — Environment Variables
# ============================================
# Copy this to .env and adjust:
#   cp .env.example .env

# === REQUIRED (both modes) ===
DEEPSEEK_API_KEY=

# === Full-stack mode (docker compose --profile full up) ===
# Uncomment these lines when running with Neo4j + PostgreSQL
 ONTO_GRAPH_STORE_TYPE=neo4j
 SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ontoevolve
 SPRING_DATASOURCE_USERNAME=ontoevolve
 SPRING_DATASOURCE_PASSWORD=ontoevolve123
 SPRING_JPA_HIBERNATE_DDL_AUTO=update
 SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
 SPRING_NEO4J_URI=bolt://neo4j:7687
 SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
 SPRING_NEO4J_AUTHENTICATION_PASSWORD=password
